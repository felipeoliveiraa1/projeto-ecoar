# Copie para .env.local (local) ou cadastre nas variáveis de ambiente da Vercel.
# Nunca coloque esses valores no código nem em mensagens.

# Azure OpenAI (recurso metodotts-ia)
AZURE_OPENAI_ENDPOINT=https://metodotts-ia.openai.azure.com
AZURE_OPENAI_API_KEY=
# Nomes das implantações (deployments) na Azure
MODELO_PRINCIPAL=gpt-6-1-sol
MODELO_RAPIDO=gpt-5-mini-1
MODELO_EMBEDDING=text-embedding-3-large

# Supabase (Project Settings › API Keys). A chave secreta só fica no servidor.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Opcional, só no ambiente local (modo prévia e Mapa do Método)
# TRECHOS_PATH=../conhecimento/trechos.jsonl
# MAPA_PATH=../conhecimento/mapa-do-metodo.md
